{
    "name": "ez-php/authorization",
    "version": "2.4.11",
    "description": "Gate and policy based authorization layer for the ez-php framework",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Andreas Uretschnig",
            "email": "andreas.uretschnig@gmail.com"
        }
    ],
    "keywords": [
        "authorization",
        "gate",
        "policy",
        "security",
        "php",
        "framework",
        "ez-php"
    ],
    "homepage": "https://github.com/ez-php/authorization",
    "support": {
        "issues": "https://github.com/ez-php/authorization/issues",
        "source": "https://github.com/ez-php/authorization"
    },
    "require": {
        "php": "^8.5",
        "ez-php/contracts": "^2.0",
        "ez-php/http": "^2.0",
        "ez-php/auth": "^2.0"
    },
    "require-dev": {
        "ez-php/docker": "^2.0",
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "EzPhp\\Authorization\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix",
        "analyse": "phpstan analyse",
        "test": "phpunit",
        "full": "composer analyse && composer cs && composer test"
    }
}
